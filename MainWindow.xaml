<Window x:Class="HotkeyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReportPalette"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Deactivated="Window_Deactivated">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Ввод ДСЕ / команд + выпадающий список (как PowerToys Command Palette) -->
        <Grid Grid.Row="0" Grid.Column="0">
            <TextBox x:Name="MyTextBox"
                     Text="Введите текст здесь..."
                     Height="30" Padding="5"
                     PreviewKeyDown="MyTextBox_PreviewKeyDown"
                     TextChanged="MyTextBox_TextChanged"/>
            <Popup x:Name="CommandsPopup"
                   PlacementTarget="{Binding ElementName=MyTextBox}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Width="430">
                    <ListBox x:Name="CommandsList"
                             MaxHeight="200"
                             MouseUp="CommandsList_MouseUp"
                             PreviewKeyDown="CommandsList_PreviewKeyDown"/>
                </Border>
            </Popup>
        </Grid>

        <!-- Кнопка открытия окна настроек -->
        <Button Grid.Row="0" Grid.Column="1" Content="⚙" Width="32" Height="30"
                Margin="5,0,0,0" ToolTip="Настройки"
                Click="SettingsButton_Click"/>

        <!-- Статус модулей: виден при первом скачивании/запуске и при ошибках -->
        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   FontSize="10" Foreground="Gray" Margin="2,4,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
