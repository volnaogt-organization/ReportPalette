<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен для NotifyIcon (значок в системном трее) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms нужен только TrayIconService (там using явный);
         глобальные implicit-юзинги убираем, чтобы не было конфликтов с WPF-типами -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- Реестр модулей: копируется рядом с exe, добавление модуля — без пересборки -->
    <None Update="modules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
