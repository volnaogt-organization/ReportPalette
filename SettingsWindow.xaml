<Window x:Class="HotkeyApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — ReportPalette"
        Width="480" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- хоткей -->
            <RowDefinition Height="Auto"/>
            <!-- панель запуска -->
            <RowDefinition Height="*"/>
            <!-- модули -->
            <RowDefinition Height="Auto"/>
            <!-- обновление программы -->
            <RowDefinition Height="Auto"/>
            <!-- перенос настроек -->
            <RowDefinition Height="Auto"/>
            <!-- кнопка закрытия -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Настройка хоткея (режим окна — кнопка 📌 на самой палитре) -->
        <StackPanel Grid.Row="0" Margin="0,5,0,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Хоткей: " VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="HotkeyBox" Width="150" IsReadOnly="True"
                         HorizontalContentAlignment="Center"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         ToolTip="Кликните сюда и нажмите желаемую комбинацию клавиш"/>
                <TextBlock Text=" (кликните и нажмите клавиши)"
                           VerticalAlignment="Center" Foreground="Gray" FontSize="10" Margin="5,0,0,0"/>
            </StackPanel>
            <CheckBox x:Name="IslandEnabledBox"
                      Content="Остров сверху экрана (перенос Excel/файлов — отчёты из таблетки)"
                      Margin="0,8,0,0"
                      Checked="IslandEnabledBox_Changed" Unchecked="IslandEnabledBox_Changed"/>
        </StackPanel>

        <!-- Панель запуска: добавленные приложения + кнопка добавления -->
        <GroupBox Grid.Row="1" Header="Панель запуска" Margin="0,5,0,5">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="+ Добавить приложение"
                        Click="AddLaunchItem_Click" Margin="0,5,0,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LaunchItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Name}"
                                            HorizontalAlignment="Left"
                                            Click="LaunchItem_Click" Tag="{Binding}"/>
                                    <Button Grid.Column="1" Content="✕" Width="24"
                                            Click="RemoveLaunchItem_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>

        <!-- Модули: версии, статус, обновление из релизов GitHub -->
        <GroupBox x:Name="ModulesBox" Grid.Row="2" Header="Модули" Margin="0,5,0,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button Content="Проверить релизы" Click="RefreshModules_Click" Margin="0,0,5,0"/>
                    <Button Content="Обновить всё" Click="UpdateAllModules_Click"/>
                </StackPanel>
                <ItemsControl x:Name="ModuleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                           FontWeight="Bold" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Info}"
                                           Foreground="Gray" FontSize="11"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Content="Обновить"
                                        Tag="{Binding Name}" Click="UpdateModule_Click"
                                        Visibility="{Binding HasModule, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </GroupBox>

        <!-- Обновление самой программы из релизов GitHub -->
        <GroupBox x:Name="AppUpdateBox" Grid.Row="3" Header="Обновление программы" Margin="0,5,0,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Проверить" Click="CheckAppUpdate_Click" Margin="0,0,5,0"/>
                    <Button x:Name="UpdateAppButton" Content="Обновить"
                            Click="UpdateApp_Click" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="AppVersionText" VerticalAlignment="Center"
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
            </DockPanel>
        </GroupBox>

        <!-- Перенос настроек: выбор секций + хеш-строка -->
        <Expander Grid.Row="4" Header="Перенос настроек (хеш-строка)" Margin="0,5,0,0">
            <StackPanel Margin="0,5,0,0">
                <TextBlock Text="Что копировать:" FontSize="11" Foreground="Gray"/>
                <WrapPanel Margin="0,2,0,5">
                    <CheckBox x:Name="SecHotkey" Content="Хоткей" IsChecked="True" Margin="0,0,8,0"/>
                    <CheckBox x:Name="SecWindow" Content="Окно" IsChecked="True" Margin="0,0,8,0"/>
                    <CheckBox x:Name="SecLaunch" Content="Приложения" IsChecked="True" Margin="0,0,8,0"/>
                    <CheckBox x:Name="SecPlugins" Content="Плагины" IsChecked="True" Margin="0,0,8,0"/>
                    <CheckBox x:Name="SecTasks" Content="Задачи" IsChecked="True" Margin="0,0,8,0"/>
                    <CheckBox x:Name="SecBackend" Content="Бэкенд" Margin="0,0,8,0"/>
                    <CheckBox x:Name="SecGeneral" Content="Общие" IsChecked="True"/>
                </WrapPanel>
                <DockPanel Margin="0,0,0,5">
                    <Button DockPanel.Dock="Right" Content="Копировать" Click="CopySettings_Click" Margin="5,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Сгенерировать" Click="GenerateSettingsHash_Click"/>
                    <TextBox x:Name="ExportHashBox" IsReadOnly="True"/>
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Применить" Click="ImportSettingsHash_Click" Margin="5,0,0,0"/>
                    <TextBox x:Name="ImportHashBox"
                             ToolTip="Вставьте сюда хеш-строку с другой машины"/>
                </DockPanel>
            </StackPanel>
        </Expander>

        <Button Grid.Row="5" Content="Закрыть" HorizontalAlignment="Right"
                MinWidth="90" Margin="0,10,0,0" Click="Close_Click"/>
    </Grid>
</Window>
