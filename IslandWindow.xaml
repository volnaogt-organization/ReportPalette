<Window x:Class="HotkeyApp.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReportPalette Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight"
        AllowDrop="True"
        DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">
    <!-- Таблетка-«остров»: свёрнутая — статус; развёрнутая — действия с файлом,
         прогресс выполнения и кнопка результата -->
    <Border x:Name="Pill" CornerRadius="18" Padding="14,7"
            Background="#E6252525" BorderBrush="#3AFFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Pill_MouseLeftButtonDown"
            MouseLeftButtonUp="Pill_MouseLeftButtonUp"
            MouseMove="Pill_MouseMove">
        <StackPanel>
            <!-- Свернутое состояние -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DotText" Text="●" Foreground="#FF4CAF50"
                           FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="ReportPalette" Foreground="White" FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="IdleHintText" Text="  ·  перетащите сюда Excel с ДСЕ"
                           Foreground="#80FFFFFF" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Развёрнутое состояние -->
            <StackPanel x:Name="ExpandedPanel" Visibility="Collapsed" Margin="2,8,2,2">
                <Grid>
                    <TextBlock x:Name="StatusText" Foreground="White" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="420" Margin="0,0,30,0"/>
                    <!-- Настройки самого острова (папка для перенесённых файлов) -->
                    <Button Content="⚙" FontSize="11" Padding="4,1"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Настройки острова"
                            Click="IslandSettingsButton_Click"/>
                </Grid>
                <StackPanel x:Name="ActionPanel" Margin="0,6,0,0"/>
                <Button x:Name="OpenResultButton" Content="📄 Открыть результат"
                        FontSize="11" Padding="8,3" Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed" Click="OpenResultButton_Click"/>

                <!-- Полка: быстрый доступ к файлам, сохранённым островом -->
                <StackPanel x:Name="ShelfPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="Файлы острова" Foreground="#80FFFFFF" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Button Content="📂" FontSize="10" Padding="4,0"
                                HorizontalAlignment="Right"
                                ToolTip="Открыть папку с файлами"
                                Click="OpenInboxButton_Click"/>
                    </Grid>
                    <StackPanel x:Name="ShelfList" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
